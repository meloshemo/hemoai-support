# HemoAI environment variables (sample)
# Copy to .env and replace values before running builds.

SENDGRID_API_KEY=SG.xxxxx_SAMPLE_KEY_xxxxx
SENDGRID_FROM_EMAIL=support@hemoai.org
SENDGRID_FROM_NAME="HemoAI Support"

STRIPE_CHECKOUT_URL=https://us-central1-flutter-ai-playground-620c6.cloudfunctions.net/createStripeCheckoutSession
STRIPE_WEBHOOK_URL=https://us-central1-flutter-ai-playground-620c6.cloudfunctions.net/stripeWebhook

APP_SUCCESS_URL=https://meloshemo.github.io/payment-success
APP_CANCEL_URL=https://meloshemo.github.io/payment-cancel

